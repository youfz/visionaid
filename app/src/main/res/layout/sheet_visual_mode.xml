<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/white" android:orientation="vertical"
    android:paddingHorizontal="@dimen/page_edge" android:paddingTop="16dp" android:paddingBottom="32dp">
    <View android:layout_width="48dp" android:layout_height="4dp" android:layout_gravity="center_horizontal"
        android:background="@color/border" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:layout_marginBottom="12dp" android:text="@string/visual_mode"
        android:textColor="@color/navy" android:textSize="@dimen/text_title" android:textStyle="bold" />
    <RadioGroup android:id="@+id/mode_group" android:layout_width="match_parent" android:layout_height="wrap_content">
        <RadioButton android:id="@+id/mode_original" android:layout_width="match_parent" android:layout_height="72dp"
            android:background="@drawable/bg_card" android:buttonTint="@color/primary_blue" android:paddingHorizontal="16dp"
            android:text="原图增强\n突出文字，保留原色" android:textColor="@color/navy" android:textSize="18sp" />
        <RadioButton android:id="@+id/mode_black" android:layout_width="match_parent" android:layout_height="72dp"
            android:layout_marginTop="@dimen/card_gap" android:background="@drawable/bg_card" android:buttonTint="@color/primary_blue"
            android:paddingHorizontal="16dp" android:text="黑底白字\n高对比度，减少眩光" android:textColor="@color/navy" android:textSize="18sp" />
        <RadioButton android:id="@+id/mode_blue" android:layout_width="match_parent" android:layout_height="72dp"
            android:layout_marginTop="@dimen/card_gap" android:background="@drawable/bg_card" android:buttonTint="@color/primary_blue"
            android:paddingHorizontal="16dp" android:text="蓝底白字\n舒适阅读，强对比度" android:textColor="@color/navy" android:textSize="18sp" />
        <RadioButton android:id="@+id/mode_yellow" android:layout_width="match_parent" android:layout_height="72dp"
            android:layout_marginTop="@dimen/card_gap" android:background="@drawable/bg_card" android:buttonTint="@color/primary_blue"
            android:paddingHorizontal="16dp" android:text="黄底黑字\n温和护眼，易于阅读" android:textColor="@color/navy" android:textSize="18sp" />
    </RadioGroup>
</LinearLayout>
