<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_dark"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#7E756D"
        android:keepScreenOn="true">

        <com.rzxz.eyealgo.gpu.GpuEnhanceView
            android:id="@+id/camera_preview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/camera_preview"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

   <!--     <android.view.TextureView
            android:id="@+id/raw_camera_preview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/raw_camera_preview"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />-->

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/photo_preview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/photo_preview"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/alignment_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_navy"
            android:gravity="center"
            android:minHeight="@dimen/touch_target"
            android:paddingHorizontal="16dp"
            android:text="@string/align_text_area"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/camera_scan_frame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/camera_scan_edge"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/camera_scan_edge"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_camera_frame"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@id/capture_button"
            app:layout_constraintDimensionRatio="7:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/alignment_hint"
            app:layout_constraintVertical_bias="0.45"
            app:layout_constraintWidth_max="@dimen/camera_scan_max_width" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/camera_retry_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/retry_camera"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/capture_button"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/capture_photo"
            app:backgroundTint="@color/white"
            app:cornerRadius="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gallery_button"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="@dimen/page_edge"
            android:layout_marginBottom="28dp"
            android:contentDescription="@string/gallery"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_gallery"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ProgressBar
            android:id="@+id/recognizing_progress"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        android:gravity="center"
        android:minHeight="104dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enhance_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="64dp"
            android:paddingHorizontal="2dp"
            android:text="@string/enhance"
            android:textColor="@color/white"
            app:icon="@drawable/ic_enhance"
            app:iconGravity="textTop"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ocr_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="64dp"
            android:paddingHorizontal="2dp"
            android:text="@string/ocr"
            android:textColor="@color/white"
            app:icon="@drawable/ic_ocr"
            app:iconGravity="textTop"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/speak_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="64dp"
            android:paddingHorizontal="2dp"
            android:text="@string/speak"
            android:textColor="@color/white"
            app:icon="@drawable/ic_speak"
            app:iconGravity="textTop"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:minHeight="64dp"
            android:paddingHorizontal="2dp"
            android:text="@string/settings"
            android:textColor="@color/white"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textTop"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
