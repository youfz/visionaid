<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reader_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/navy" android:orientation="vertical" android:padding="@dimen/page_edge">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/back_button"
            style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp"
            android:contentDescription="@string/back" android:text="‹" android:textColor="@color/white" android:textSize="36sp" />
        <TextView android:id="@+id/reader_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/enhanced_reading" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/change_mode_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="@string/change_mode" android:textColor="@color/white"
            app:strokeColor="@color/white" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
        <TextView android:id="@+id/reading_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:lineSpacingExtra="16dp" android:paddingVertical="40dp"
            android:textColor="@color/white" android:textSize="@dimen/text_reading" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="88dp" android:gravity="center"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/decrease_button"
            android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
            android:text="A-\n减小" android:textColor="@color/navy" app:backgroundTint="@color/white" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/increase_button"
            android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
            android:text="A+\n放大" android:textColor="@color/navy" app:backgroundTint="@color/white" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/reader_speak_button"
            android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1"
            android:text="@string/speak" android:textColor="@color/navy" app:backgroundTint="@color/white"
            app:icon="@drawable/ic_speak" />
    </LinearLayout>
</LinearLayout>
